---&gt; 25     with open(f&quot;{search_strategy}/pubmed/pm_{x}.txt&quot;, &#39;w&#39;) as f:
     26         f.write(f&quot;{acl} AND {rct} AND {y}&quot;)
     27     #globals()[f&quot;reviews_pm_{x}&quot;] = f&quot;{acl} AND {rct} AND {y}&quot;

