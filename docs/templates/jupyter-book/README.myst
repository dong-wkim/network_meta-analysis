<div id="eedfe910-f3b3-487f-879b-6928801e7908" class="cell markdown">
<p>Exclude certain files from syncing with remote github repository with
<code>gitignore</code> file.</p>
</div>
<div id="b3db5113-25fd-41c2-8517-2adc1e3d9048" class="cell code">
<div class="sourceCode" id="cb10"><pre
class="sourceCode python"><code class="sourceCode python"><span id="cb10-1"><a href="#cb10-1" aria-hidden="true" tabindex="-1"></a>ignore <span class="op">=</span> <span class="ss">f&quot;&quot;&quot;.venv/</span></span>
<span id="cb10-2"><a href="#cb10-2" aria-hidden="true" tabindex="-1"></a><span class="ss">*/*.gsheet</span></span>
<span id="cb10-3"><a href="#cb10-3" aria-hidden="true" tabindex="-1"></a><span class="ss">*/*.gdoc&quot;&quot;&quot;</span></span>
<span id="cb10-4"><a href="#cb10-4" aria-hidden="true" tabindex="-1"></a></span>
<span id="cb10-5"><a href="#cb10-5" aria-hidden="true" tabindex="-1"></a>gitignore <span class="op">=</span> [<span class="st">&#39;.venv/&#39;</span>, <span class="st">&#39;.gsheet&#39;</span>, <span class="st">&#39;.gdoc&#39;</span>]</span>
<span id="cb10-6"><a href="#cb10-6" aria-hidden="true" tabindex="-1"></a>ignore <span class="op">=</span> <span class="st">&quot;</span><span class="ch">\n</span><span class="st">&quot;</span>.join(gitignore)</span>
<span id="cb10-7"><a href="#cb10-7" aria-hidden="true" tabindex="-1"></a><span class="cf">with</span> <span class="bu">open</span>(<span class="ss">f&quot;./.gitignore&quot;</span>, <span class="st">&quot;w&quot;</span>) <span class="im">as</span> f:</span>
<span id="cb10-8"><a href="#cb10-8" aria-hidden="true" tabindex="-1"></a>    f.write(ignore)</span></code></pre></div>
</div>
