<div id="313ab029-4543-4d62-9052-0f678a537ccc" class="cell markdown">
<p>Install <code>PyPI</code> modules in
<code>requirements.txt</code>.</p>
</div>
<div id="7428ca33-ed54-43d7-8872-800872b2d0d7" class="cell code">
<div class="sourceCode" id="cb3"><pre
class="sourceCode python"><code class="sourceCode python"><span id="cb3-1"><a href="#cb3-1" aria-hidden="true" tabindex="-1"></a><span class="op">!</span>pandoc <span class="op">-</span>f docx <span class="op">-</span>t markdown_strict<span class="op">+</span>pipe_tables <span class="st">&quot;PRISMA NMA checklist.docx&quot;</span> <span class="op">-</span>o prisma<span class="op">-</span>nma.md </span></code></pre></div>
</div>
<div id="19ed74e2-44c5-4224-bd14-47f5fe3185d0" class="cell code">
<div class="sourceCode" id="cb4"><pre
class="sourceCode python"><code class="sourceCode python"><span id="cb4-1"><a href="#cb4-1" aria-hidden="true" tabindex="-1"></a><span class="op">!</span>pandoc <span class="op">-</span>f html <span class="op">-</span>t markdown_strict<span class="op">+</span>pipe_tables prisma<span class="op">-</span>nma.html <span class="op">-</span>o prisma<span class="op">-</span>nma.md </span></code></pre></div>
</div>
<div id="32daa4dc-d5f9-4ad8-8468-227356840bd7" class="cell code">
<div class="sourceCode" id="cb5"><pre
class="sourceCode python"><code class="sourceCode python"><span id="cb5-1"><a href="#cb5-1" aria-hidden="true" tabindex="-1"></a><span class="op">!</span>pip install <span class="op">-</span>r requirements.txt</span></code></pre></div>
</div>
<div id="eedfe910-f3b3-487f-879b-6928801e7908" class="cell markdown">
<p>Exclude certain files from syncing with remote github repository with
<code>gitignore</code> file.</p>
</div>
<div id="b3db5113-25fd-41c2-8517-2adc1e3d9048" class="cell code">
<div class="sourceCode" id="cb6"><pre
class="sourceCode python"><code class="sourceCode python"><span id="cb6-1"><a href="#cb6-1" aria-hidden="true" tabindex="-1"></a>ignore <span class="op">=</span> <span class="ss">f&quot;&quot;&quot;.venv/</span></span>
<span id="cb6-2"><a href="#cb6-2" aria-hidden="true" tabindex="-1"></a><span class="ss">*/*.gsheet</span></span>
<span id="cb6-3"><a href="#cb6-3" aria-hidden="true" tabindex="-1"></a><span class="ss">*/*.gdoc&quot;&quot;&quot;</span></span>
<span id="cb6-4"><a href="#cb6-4" aria-hidden="true" tabindex="-1"></a></span>
<span id="cb6-5"><a href="#cb6-5" aria-hidden="true" tabindex="-1"></a>gitignore <span class="op">=</span> [<span class="st">&#39;.venv/&#39;</span>, <span class="st">&#39;.gsheet&#39;</span>, <span class="st">&#39;.gdoc&#39;</span>]</span>
<span id="cb6-6"><a href="#cb6-6" aria-hidden="true" tabindex="-1"></a>ignore <span class="op">=</span> <span class="st">&quot;</span><span class="ch">\n</span><span class="st">&quot;</span>.join(gitignore)</span>
<span id="cb6-7"><a href="#cb6-7" aria-hidden="true" tabindex="-1"></a><span class="cf">with</span> <span class="bu">open</span>(<span class="ss">f&quot;./.gitignore&quot;</span>, <span class="st">&quot;w&quot;</span>) <span class="im">as</span> f:</span>
<span id="cb6-8"><a href="#cb6-8" aria-hidden="true" tabindex="-1"></a>    f.write(ignore)</span></code></pre></div>
</div>
