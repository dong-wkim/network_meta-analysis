            <rdf:Bag>
               <rdf:li>anterior cruciate ligament</rdf:li>
               <rdf:li>anterior cruciate ligament reconstruction</rdf:li>
               <rdf:li>myofascial pain syndrome</rdf:li>
               <rdf:li>physical therapy</rdf:li>
               <rdf:li>modalities</rdf:li>
               <rdf:li>rehabilitation</rdf:li>
               <rdf:li>trigger points</rdf:li>
               <rdf:li>ligamento anterior cruzado</rdf:li>
               <rdf:li>reconstrucciÃ³n del ligamento anterior cruzado</rdf:li>
               <rdf:li>sindrome de dolor miofascial</rdf:li>
               <rdf:li>modalidades de terapia fÃ­sica</rdf:li>
               <rdf:li>rehabilitaciÃ³n</rdf:li>
               <rdf:li>puntos de activaciÃ³n</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:creator>
