            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Does the hyperextension maneuver prevent knee extension loss after arthroscopic anterior cruciate ligament reconstruction?</rdf:li>
            </rdf:Alt>
         </dc:title>
